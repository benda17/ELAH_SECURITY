{
  "name": "elah-banking-simulation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && npm run db:seed",
    "simulator:reset": "tsx scripts/simulator-reset.ts",
    "seed:phase1": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "seed:dataset": "tsx scripts/seed-from-dataset.ts",
    "seed:demo-logins": "tsx scripts/ensure-canonical-demo-logins.ts",
    "seed:more": "tsx --require ./scripts/lib/preload-server-only.cjs scripts/seed-more-activity.ts",
    "seed:agent-scenarios": "tsx scripts/seed-agent-test-scenarios.ts",
    "scenarios:phase1": "tsx --require ./scripts/lib/preload-server-only.cjs scripts/run-phase1-scenarios.ts",
    "export:elah-events": "tsx --require ./scripts/lib/preload-server-only.cjs scripts/export-elah-events.ts",
    "normalize:elah-logs": "tsx --require ./scripts/lib/preload-server-only.cjs scripts/normalize-elah-logs.ts",
    "dataset:generate": "tsx scripts/generate-phase4-dataset.ts",
    "dataset:iaa": "tsx scripts/compute-phase4-iaa.ts",
    "test:phase4-dataset": "vitest run tests/elah/dataset-schema.test.ts tests/elah/dataset-normalize.test.ts tests/elah/dataset-generate.test.ts tests/elah/dataset-split.test.ts tests/elah/dataset-iaa.test.ts",
    "baseline:eval": "tsx --require ./scripts/lib/preload-server-only.cjs scripts/evaluate-phase5-baseline.ts",
    "test:phase5-baseline": "vitest run tests/elah/baseline-features.test.ts tests/elah/baseline-normalize.test.ts tests/elah/baseline-score.test.ts tests/elah/baseline-fixtures.test.ts tests/elah/baseline-metrics.test.ts tests/elah/baseline-evaluate.test.ts tests/elah/mock-scorer.test.ts",
    "test:phase1-events": "vitest run tests/events",
    "test:phase9-analyst": "vitest run tests/elah/analyst-filters.test.ts tests/elah/analyst-bands.test.ts tests/elah/analyst-rbac.test.ts tests/elah/analyst-export.test.ts tests/elah/analyst-stats.test.ts tests/elah/analyst-annotations.test.ts tests/elah/analyst-ingest-exclusion.test.ts tests/elah/analyst-query.test.ts",
    "seed:intent-matrix": "tsx --require ./scripts/lib/preload-server-only.cjs scripts/seed-intent-matrix.ts",
    "clean:injection-data": "tsx scripts/clean-injection-data.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "next": "14.2.18",
    "openai": "^4.104.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "server-only": "^0.0.1",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.9"
  }
}
