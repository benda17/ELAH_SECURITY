# ELAH Banking System — Vercel environment variables
# Import: Vercel → Project → Settings → Environment Variables → "Import .env"
# Or paste each line in the bulk editor. Apply to Production, Preview, Development.
#
# After import: redeploy ELAH_BANKING_SYSTEM branch.
#
# REQUIRED: Create a free Postgres DB (Neon is easiest: https://neon.tech)
# then paste the connection string below. SQLite does NOT work on Vercel.

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
AUTH_SECRET=OS9SsEuw+mHOi5AT8D0idmbmmyUIesbSF4aCTxhWi1hWKMwE2629RZIRAqcdSn8l
LOG_MIRROR_JSONL=false
OPENAI_MODEL=gpt-4o-mini

