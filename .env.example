# ELAH Platform — environment variables
# Copy to .env for local development. On Vercel, add these in Project → Settings → Environment Variables.

# Shared Neon Postgres (same DATABASE_URL as Banking System)
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX.neon.tech/neondb?sslmode=require"

# Link to the separate banking demo app
BANKING_APP_URL="http://localhost:3002"
NEXT_PUBLIC_BANKING_APP_URL="http://localhost:3002"

# --- Free LLM (preferred) ---
# Create at https://console.groq.com/keys (free, no OpenAI credits)
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# Optional free fallback: https://aistudio.google.com/apikey
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.0-flash"

# Optional paid fallback (not required)
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"

# LinkedIn OAuth (Developer App → Auth)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
# MUST be the callback path (not the homepage):
LINKEDIN_REDIRECT_URI="https://elahfounderplatform.vercel.app/api/linkedin/callback"
# Default scope is w_member_social only (Share on LinkedIn product).
# LINKEDIN_OAUTH_SCOPES="w_member_social"
# Person/org URN required to publish when openid/profile scopes are unavailable:
# LINKEDIN_AUTHOR_URN="urn:li:person:XXXX"
# LINKEDIN_ORGANIZATION_ID=""
# LINKEDIN_ACCESS_TOKEN=""   # only if skipping OAuth Connect button

# Cron protection for /api/cron/*
CRON_SECRET=""

# Content engine toggles
CONTENT_ENGINE_ENABLED="true"
CONTENT_AUTO_PUBLISH="false"

# Newsletter (Resend). Leave empty locally to see a clear send error — never commit real keys.
# Resend typically cannot send FROM gmail.com until you verify a domain you own
# (elahsecurity.com). If Gmail is rejected, verify the domain in Resend and keep
# elahsecurity@gmail.com as Reply-To.
RESEND_API_KEY=""
RESEND_FROM="ELAH <elahsecurity@gmail.com>"

# X / Twitter (Content Engine cross-post + one-time landing thread).
# Create at https://developer.x.com/en/portal/dashboard — not x.com/settings.
# X_API_KEY=""
# X_API_SECRET=""
# X_ACCESS_TOKEN=""
# X_ACCESS_TOKEN_SECRET=""
# Extra CORS origins for POST /api/newsletter/subscribe and POST /api/demo/request
# (comma-separated). Defaults already include localhost:3000/3001 and elahsecurity.com.
# NEWSLETTER_CORS_ORIGINS="http://localhost:3000,http://localhost:3001"
