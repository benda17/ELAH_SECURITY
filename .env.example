# ELAH Platform — environment variables
# Copy to .env for local development. On Vercel, add these in Project → Settings → Environment Variables.

# Shared Neon Postgres (same DATABASE_URL as Banking System)
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX.neon.tech/neondb?sslmode=require"

# Link to the separate banking demo app
BANKING_APP_URL="http://localhost:3002"
NEXT_PUBLIC_BANKING_APP_URL="http://localhost:3002"

# OpenAI (content engine draft generation)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Content search (optional — for source event scanning)
CONTENT_SEARCH_PROVIDER=""
CONTENT_SEARCH_API_KEY=""

# LinkedIn OAuth (optional until publish is enabled)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI=""
LINKEDIN_ORGANIZATION_ID=""

# Cron protection for /api/cron/*
CRON_SECRET=""

# Content engine toggles
CONTENT_ENGINE_ENABLED="false"
CONTENT_AUTO_PUBLISH="false"
