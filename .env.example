# --- Database ---
# Local: Postgres (Docker: docker compose up -d)
#   DATABASE_URL="postgresql://elah:elah@localhost:5432/elah_banking?schema=public"
# Production (Vercel): Neon / Vercel Postgres connection string
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DATABASE_URL="postgresql://elah:elah@localhost:5432/elah_banking?schema=public"

# --- Auth ---
# Used to sign session cookies. Generate with: openssl rand -base64 48
AUTH_SECRET="elah-local-poc-secret-change-me-please-32bytes-min-xxxxxxxx"

# --- Logging ---
# When true (default) audit/agent/risk logs are also mirrored to /logs/*.jsonl
LOG_MIRROR_JSONL="true"

# Where to write JSONL log mirrors (relative to project root).
LOG_DIR="./logs"

# --- AI Assistant (optional) ---
# When set, the in-app assistant uses OpenAI function-calling.
# Without it, a rules-based fallback planner handles common banking requests.
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"

# --- ELAH scoring service (Phase 3) ---
# Shared bearer for POST /v1/score (simulator ↔ scorer). Not a user session.
# ELAH_SERVICE_TOKEN="replace-with-a-long-random-token-min-32-chars"
# Leave unset to call handleScore in-process. Set only for a remote scorer.
# ELAH_SERVICE_URL="http://127.0.0.1:3000"
# Client fail-open timeout in ms (contract ceiling is 250).
# ELAH_SCORE_TIMEOUT_MS=250
