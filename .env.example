# --- Database ---
# SQLite local file path. Prisma needs a file:./prefix.
DATABASE_URL="file:./dev.db"

# --- Auth ---
# Used to sign session cookies. Generate with: openssl rand -base64 48
AUTH_SECRET="elah-local-poc-secret-change-me-please-32bytes-min-xxxxxxxx"

# --- Logging ---
# When true (default) audit/agent/risk logs are also mirrored to /logs/*.jsonl
LOG_MIRROR_JSONL="true"

# Where to write JSONL log mirrors (relative to project root).
LOG_DIR="./logs"

# --- AI Assistant (optional) ---
# When set, the in-app assistant uses OpenAI function-calling.
# Without it, a rules-based fallback planner handles common banking requests.
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"
