# ELAH Platform — environment variables
# Copy to .env for local development. On Vercel, add these in Project → Settings → Environment Variables.

# Shared Neon Postgres (same DATABASE_URL as Banking System)
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX.neon.tech/neondb?sslmode=require"

# Link to the separate banking demo app
BANKING_APP_URL="http://localhost:3002"
NEXT_PUBLIC_BANKING_APP_URL="http://localhost:3002"

# --- Free LLM (preferred) ---
# Create at https://console.groq.com/keys (free, no OpenAI credits)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Optional free fallback: https://aistudio.google.com/apikey
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.0-flash"

# Optional paid fallback (not required)
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"

# LinkedIn OAuth (Developer App → Auth)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="https://elah-security.vercel.app/api/linkedin/callback"
# Optional: company page numeric ID, or full URN
# LINKEDIN_ORGANIZATION_ID=""
# LINKEDIN_AUTHOR_URN="urn:li:person:XXXX"
# LINKEDIN_ACCESS_TOKEN=""   # only if skipping OAuth Connect button

# Cron protection for /api/cron/*
CRON_SECRET=""

# Content engine toggles
CONTENT_ENGINE_ENABLED="true"
CONTENT_AUTO_PUBLISH="false"
